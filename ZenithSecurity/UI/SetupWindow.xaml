<Window x:Class="ZenithSecurity.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup – Zenith Local Security Dashboard 4.0"
        Width="480" Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F1523">

  <Window.Resources>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#E2E8F0"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize"   Value="13"/>
      <Setter Property="Margin"     Value="0,4,0,4"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E2E8F0"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Background"  Value="#3B82F6"/>
      <Setter Property="Foreground"  Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding"     Value="24,8"/>
      <Setter Property="FontFamily"  Value="Segoe UI"/>
      <Setter Property="FontSize"    Value="13"/>
      <Setter Property="Cursor"      Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#60A5FA"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
      <Setter Property="Background"  Value="#1A2540"/>
      <Setter Property="Foreground"  Value="#E2E8F0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="Welcome to Zenith Local Security Dashboard 4.0"
                 FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="Specify whether to install the application or just run it."
                 Foreground="#64748B" FontSize="12" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Already installed notice (hidden by default) -->
    <Border x:Name="AlreadyBorder" Grid.Row="1"
            Background="#1A2540" CornerRadius="4" Padding="12,8"
            Margin="0,0,0,12" Visibility="Collapsed">
      <TextBlock x:Name="AlreadyText" Foreground="#60A5FA" FontSize="12"
                 Text="Program is already installed."/>
    </Border>

    <!-- Options -->
    <StackPanel Grid.Row="2">
      <TextBlock Text="Select action:" Foreground="#64748B" FontSize="12" Margin="0,0,0,10"/>

      <RadioButton x:Name="RbInstall" IsChecked="True" GroupName="action">
        <StackPanel Margin="6,0,0,0">
          <TextBlock Text="Install" FontWeight="SemiBold"/>
          <TextBlock Text="Install to AppData and create shortcuts (recommended)"
                     Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
        </StackPanel>
      </RadioButton>

      <RadioButton x:Name="RbRun" GroupName="action" Margin="0,10,0,0">
        <StackPanel Margin="6,0,0,0">
          <TextBlock Text="Run"/>
          <TextBlock Text="Run portable version (no installation needed)"
                     Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
        </StackPanel>
      </RadioButton>

      <CheckBox x:Name="ChkAdvanced" Content="Advanced settings"
                Foreground="#64748B" FontSize="11"
                Margin="0,16,0,0"/>
    </StackPanel>

    <!-- Buttons -->
    <StackPanel Grid.Row="3" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="BtnCancel" Content="Cancel"
              Style="{StaticResource SecondaryBtn}"
              Click="BtnCancel_Click" Margin="0,0,8,0"/>
      <Button x:Name="BtnNext" Content="Next >"
              Style="{StaticResource PrimaryBtn}"
              Click="BtnNext_Click"/>
    </StackPanel>
  </Grid>
</Window>
